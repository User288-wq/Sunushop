{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "EVOLUTION_API_URL": "https://arson-immovably-prorate.ngrok-free.dev",
    "EVOLUTION_API_KEY": "429683C4C977415CAAFCCE10F7D57E11",
    "EVOLUTION_INSTANCE": "sunushop",
    "NEXT_PUBLIC_SITE_URL": "https://www.sunu-shop.org",
    "NEXT_PUBLIC_APP_URL": "https://www.sunu-shop.org"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
